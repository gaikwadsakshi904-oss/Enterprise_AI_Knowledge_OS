import { useEffect, useState } from "react";
import api from "../lib/api";

export default function Report() {
    const [history, setHistory] = useState([]);
    const [loading, setLoading] = useState(true);
    const [error, setError] = useState("");

    const loadReport = async () => {
        try {
            setLoading(true);
            setError("");

            const data = await api.getHistory();

            const items = Array.isArray(data)
                ? data
                : data?.history || data?.investigations || data?.items || [];

            setHistory(items);
        } catch (err) {
            console.error(err);
            setError(err?.message || "Unable to load investigation history.");
        } finally {
            setLoading(false);
        }
    };

    useEffect(() => {
        loadReport();
    }, []);

    return (
        <div className="report-page">

            <header className="report-hero">
                <div>
                    <div className="report-eyebrow">
                        ENTERPRISE INTELLIGENCE
                    </div>

                    <h1>Executive Reports</h1>

                    <p>
                        Investigation results, evidence and remediation intelligence.
                    </p>
                </div>

                <button
                    className="report-export"
                    onClick={() => window.print()}
                >
                    Export / Print Report
                </button>
            </header>

            {loading && (
                <section className="report-panel">
                    <div className="report-loading">
                        <div className="report-spinner" />
                        <h2>Loading intelligence...</h2>
                        <p>Retrieving investigation history.</p>
                    </div>
                </section>
            )}

            {error && !loading && (
                <section className="report-panel report-error">
                    <div className="report-eyebrow">SYSTEM ERROR</div>
                    <h2>Unable to load reports</h2>
                    <p>{error}</p>
                    <button
                        className="report-retry"
                        onClick={loadReport}
                    >
                        Retry
                    </button>
                </section>
            )}

            {!loading && !error && (
                <>
                    <section className="report-panel">

                        <div className="report-section-header">
                            <div>
                                <div className="report-eyebrow">
                                    INVESTIGATION HISTORY
                                </div>

                                <h2>Executive Intelligence</h2>
                            </div>

                            <div className="report-count">
                                <strong>{history.length}</strong>
                                <span>reports</span>
                            </div>
                        </div>

                        {history.length === 0 ? (
                            <div className="report-empty">
                                <div className="empty-icon">◉</div>
                                <h3>No investigations yet</h3>
                                <p>
                                    Run an investigation to generate executive
                                    intelligence and evidence-backed reports.
                                </p>
                            </div>
                        ) : (
                            <div className="report-grid">
                                {history.map((item, index) => {

                                    const question =
                                        item.question ||
                                        item.query ||
                                        item.title ||
                                        "Investigation";

                                    const answer =
                                        item.answer ||
                                        item.response ||
                                        item.summary ||
                                        item.result ||
                                        "";

                                    const date =
                                        item.created_at ||
                                        item.timestamp ||
                                        item.date;

                                    return (
                                        <article
                                            className="report-card"
                                            key={item.id || item.investigation_id || index}
                                        >
                                            <div className="report-card-top">
                                                <span className="report-number">
                                                    REPORT #{history.length - index}
                                                </span>

                                                {date && (
                                                    <span className="report-date">
                                                        {new Date(date).toLocaleString()}
                                                    </span>
                                                )}
                                            </div>

                                            <div className="report-status">
                                                <span className="status-dot" />
                                                Investigation completed
                                            </div>

                                            <h3>{question}</h3>

                                            <p className="report-summary">
                                                {answer || "No report summary available."}
                                            </p>

                                            <div className="report-card-footer">
                                                <span>AI Investigation</span>
                                                <span>View intelligence →</span>
                                            </div>
                                        </article>
                                    );
                                })}
                            </div>
                        )}
                    </section>
                </>
            )}
        </div>
    );
}
