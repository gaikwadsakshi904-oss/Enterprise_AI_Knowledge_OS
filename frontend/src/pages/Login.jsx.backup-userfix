import { useState } from "react";
import { useNavigate } from "react-router-dom";

export default function Login() {
  const navigate = useNavigate();

  const [email, setEmail] = useState("admin@enterprise.local");
  const [password, setPassword] = useState("demo-password");

  const handleLogin = (e) => {
    e.preventDefault();

    const cleanEmail = email.trim();

    if (!cleanEmail) return;

    localStorage.setItem("eakos_auth", "true");
    localStorage.setItem("eakos_user", cleanEmail);

    const emailName = cleanEmail
      .split("@")[0]
      .replace(/[._-]+/g, " ")
      .replace(/\b\w/g, (char) => char.toUpperCase());

    localStorage.setItem("eakos_name", emailName);

    navigate("/dashboard");
  };

  return (
    <div className="login">

      <div className="login-left">

        <div className="brand">
          <b>E</b>

          <div>
            <strong>EAKOS</strong>
            <small>Enterprise AI Knowledge OS</small>
          </div>
        </div>

        <div className="hero">

          <small>
            INTELLIGENCE • GOVERNANCE • ACTION
          </small>

          <h1>
            Enterprise knowledge into{" "}
            <em>decision intelligence.</em>
          </h1>

          <p>
            Governed AI for enterprise evidence retrieval,
            security investigation, risk analysis and
            audit-ready remediation.
          </p>

          <div className="pills">
            <span>RAG-powered</span>
            <span>Evidence-based</span>
            <span>Audit-ready</span>
          </div>

        </div>

        <footer>
          ◉ Protected enterprise workspace
        </footer>

      </div>

      <div className="login-right">

        <form onSubmit={handleLogin}>

          <small>WELCOME BACK</small>

          <h2>Sign in to EAKOS</h2>

          <p>
            Access your enterprise intelligence workspace.
          </p>

          <label>Work email</label>

          <input
            type="email"
            value={email}
            onChange={(e) => setEmail(e.target.value)}
            required
          />

          <label>Password</label>

          <input
            type="password"
            value={password}
            onChange={(e) => setPassword(e.target.value)}
            required
          />

          <button type="submit">
            Enter workspace →
          </button>

          <aside>
            DEMO MODE — authentication is local for this submission build.
          </aside>

        </form>

      </div>

    </div>
  );
}
